@inject IHostApplicationLifetime Lifetime
<div class="container py-3 px-3">
    <strong class="text-white">RINCON CRM</strong>
</div>
<div class="nav-scrollable" onclick="OnEmptyClick">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                HOME
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                PROJECTS
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="companies">
                COMPANIES
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="contacts">
                CONTACTS
            </NavLink>
        </div>

        <button class="btn btn-danger ms-3 mt-2" @onclick="CerrarApp">Cerrar App</button>
    </nav>
</div>

@code{
    void CerrarApp()
    {
        Lifetime.StopApplication();
    }
}