@page "/"
@page "/{CompanyId:int}"
@using MyCrm.Shared
@using MyCrm.Web.Service
@inject ProjectService ProjectService
@inject CompanyService CompanyService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Projects - MyCRM</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Projects</h1>
    <NavLink class="btn btn-primary" href="@(CompanyId.HasValue ? $"/projectform/new/{CompanyId}" : "/projectform")" style="margin-left: auto;">
        Add Project
    </NavLink>
</div>


@if (allProjects == null)
{
    <p><em>Connecting to DataBase...</em></p>
}
else if (!allProjects.Any())
{
    <div class="alert-info">
        There are no projects available. Time to create one!
    </div>
}
else
{
    <input type="text" class="form-control mb-3" placeholder="Search Project..." @bind-value="searchText" @bind-value:event="oninput" />
    @foreach (var group in filteredProjects.GroupBy(pr => pr.Company?.Name ?? "No Company"))
    {
        <h3 class="mt-5 mb-3 text-secondary border-bottom pb-2" style="font-size: 1.1rem; font-weight: 600;">
            <i class="bi bi-building me-2"></i> @group.Key
        </h3>

        <div class="d-flex flex-wrap gap-3 mb-5">
            @foreach (var pr in group)
            {
                <div class="card shadow-sm border-0" style="width: 310px; border-radius: 12px; background: #ffffff;">
                    <div class="card-body d-flex flex-column p-3">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @(pr.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill border" style="font-size: 0.7rem;">
                                @(pr.Status)
                            </span>
                            <small class="text-muted fw-bold">#@pr.Id</small>
                        </div>

                        <h6 class="card-title mb-1 fw-bold text-dark">@pr.Name <i>- @pr.Budget€</i></h6>
                       

                        <p class="text-muted mb-3" style="font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                            @pr.Description
                        </p>

                        <div class="mt-auto pt-2 border-top">
                            <div class="d-flex justify-content-between">
                                <div class="text-muted" style="font-size: 0.7rem;">
                                    <i class="bi bi-play-fill text-success"></i> START
                                    <div class="text-dark fw-bold">@pr.StartingDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="text-muted text-end" style="font-size: 0.7rem;">
                                    <i class="bi bi-stop-fill text-danger"></i> FINAL DATE
                                    <div class="text-dark fw-bold">@(pr.EndingDate.ToString("dd/MM/yyyy"))</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                            <NavLink href="@($"/projectform/{pr.Id}")" class="btn btn-sm btn-outline-primary fw-bold px-3" style="font-size: 0.75rem; border-radius: 6px;">
                                Edit
                            </NavLink>
                            <button class="btn btn-danger" @onclick="() => Delete(pr.Id)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    
}


@code{
    [Parameter] public int? CompanyId {get; set;}
    private List<Project>? allProjects;
    private string searchText = "";

    private IEnumerable<Project> filteredProjects =>
     allProjects?.Where(c => string.IsNullOrWhiteSpace(searchText)
         || c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
         || (c.Company?.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
     ?? Enumerable.Empty<Project>();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }
    private async Task LoadProjects()
    {
        if (CompanyId.HasValue)
        {
            allProjects = await ProjectService.GetByCompany(CompanyId.Value);
        }
        else
        {
            allProjects = await ProjectService.GetAll();
        }
        
    }
    protected async Task Delete(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete it?");
        if (confirmed)
        {
            await ProjectService.Delete(id);
            await LoadProjects();
        }
    }
}