@page "/projectform"
@page "/projectform/{Id:int}"
@using MyCrm.Web.Service
@using MyCrm.Shared
@inject ProjectService ProjectService
@inject CompanyService CompanyService
@inject NavigationManager Navigation
@rendermode InteractiveServer
<PageTitle>Project Form - MyCRM</PageTitle>

<div class="conteiner mt-4">
    <div class="card shadow-sm">
        <div class="card-header @(Id == null ? "bg-success" : "bg-primary") text-white">
            <h3>@(Id == null ? "Add Project" : "Modify Project")</h3>
        </div> 
        <div class="card-body">
            @if (allCompanies == null)
            {
                <p>Loading Companies...</p>
            }
            else if (!allCompanies.Any())
            {
                <div class="alert-warning">
                    <p>You can not create any Projects without any Companies Available</p>
                    <a href="companies/companyform" class="btn btn-warning">Add Company Now</a>
                </div>
            }
            else
            {
                <EditForm Model="project" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <InputText @bind-Value="project.Name" class="form-control" />
                    </div>

                    <div class=" mb-3">
                        <label class="form-label">Description</label>
                            <textarea rows="4" cols="30">
                                <InputText @bind-Value="project.Description" class="form-control" />
                            </textarea>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status</label>
                            <InputSelect @bind-Value="project.Status" class="form-select">
                                @foreach(var state in Enum.GetValues<Project.ProjectStatus>())
                                {
                                    <option value="@state">@state</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Company</label>
                            <InputSelect @bind-Value="project.CompanyId" class="form-select">
                                @foreach (var company in allCompanies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            </InputSelect>
                        </div>
                        
                    </div>
                </EditForm>
            }
        </div>
        <div class="d-flex justify-content-between gap-2">
            <button type="button" class=" btn btn-secondary" @onclick="Return">Cancel</button>
            <button type="submit" class="btn btn-primary">
                @(Id == null ? "Create" : "Save")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    Project project = new() { StartingDate = DateTime.Now };

    private List<Company>? allCompanies;

    protected override async Task OnParametersSetAsync()
    {
        if(Id.HasValue)
        {
            var found = await ProjectService.GetById(Id.Value);
            if (found != null) project = found;
        }
        else
        {
            project = new Project();
        }
    }

    protected async Task Save()
    {
        if (Id == null) await ProjectService.Add(project);
        else
        {
            await ProjectService.Update(project);
        }
        Navigation.NavigateTo("/");
    }

    private void Return() => Navigation.NavigateTo("/");
}
