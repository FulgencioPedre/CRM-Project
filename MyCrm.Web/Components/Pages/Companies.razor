@page "/companies"
@using MyCrm.Shared
@using MyCrm.Web.Service
@inject CompanyService CompanyService
@inject IJSRuntime JS
@rendermode InteractiveServer


<PageTitle>Companies - MyCRM</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Companies</h1>
    <NavLink class="btn btn-primary" href="companies/companyform" style="margin-left: auto">
        Add Company
    </NavLink>
</div>


@if(allCompanies == null)
{
    <p><em>Connecting to DataBase...</em></p>
}
else if (!allCompanies.Any())
{
    <div class="alert-info">
        There are no Companies Available at the DataBase.
    </div>
}
else
{

    <ul class="list-unstyled">
        <input type="text" class="form-control mb-3" placeholder="Search Company..." @bind-value="searchText" @bind-value:event="oninput" />
        @foreach (var c in filteredCompanies)
        {
            <li class="shadow-sm p-2 mb-2 bg-white rouder border-start border-4 border-primary">
                <strong>@c.Name - @c.CIF</strong> | @c.Address - @c.Country
                <div class="flex" style="margin-left: auto">
                    <NavLink class="btn btn-primary ps-2" href="@($"companies/companyform/{c.Id}")">
                        Modify
                    </NavLink>
                    <button type="button" class="btn btn-danger ms-2" @onclick="() => Delete(c.Id)">
                        Delete
                    </button>
                    <NavLink class="btn btn-primary ps-2" href="@($"/contacts/{c.Id}")">
                        Show Contacts
                    </NavLink>
                    <NavLink class="btn btn-primary ps-2" href="@($"/{c.Id}")">
                        Show Projects
                    </NavLink>
                </div>
            </li>
        }
    </ul>
}


@code {
    private List<Company>? allCompanies;
    private string searchText = "";
    private IEnumerable<Company> filteredCompanies => allCompanies?.Where(c => string.IsNullOrWhiteSpace(searchText)
    || c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) || (c.CIF != null && c.CIF.Contains(searchText, StringComparison.OrdinalIgnoreCase))) ?? Enumerable.Empty<Company>();

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    private async Task LoadCompanies()
    {
        allCompanies = await CompanyService.GetAll();
    }
    protected async Task Delete(int id)
    {

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete it?");
        if (confirmed)
        {
            await CompanyService.Delete(id);
            await LoadCompanies();
        }
        
    }

}
